# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- Database (PostgreSQL) ---
# Local dev via docker-compose.yml:
DATABASE_URL="postgresql://hatzaa:hatzaa@localhost:5432/hatzaa?schema=public"

# --- Auth (NextAuth) ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (optional login method)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Set to "true" only once GOOGLE_CLIENT_ID/SECRET above are filled in —
# controls whether the "Continue with Google" button is shown client-side.
NEXT_PUBLIC_GOOGLE_ENABLED="false"

# --- Payments ---
# Which PaymentProvider implementation is active. "paypal" (default) needs
# no Israeli business registration to start; "cardcom" is the
# locally-optimized Israeli option once the business has an עוסק
# מורשה/פטור number. See src/lib/payments/PROVIDER_COMPARISON.md.
PAYMENT_PROVIDER="paypal"

# --- Payments: PayPal ---
# Get these from developer.paypal.com (sandbox first, then live). Plan IDs
# come from running `npx tsx scripts/setup-paypal-plans.ts` once.
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
PAYPAL_ENV="sandbox"
PAYPAL_PLAN_PRO_MONTHLY=""
PAYPAL_PLAN_PRO_YEARLY=""
PAYPAL_PLAN_BUSINESS_MONTHLY=""
PAYPAL_PLAN_BUSINESS_YEARLY=""

# --- Payments: Cardcom (Israeli payment provider, optional/future) ---
CARDCOM_TERMINAL_NUMBER=""
CARDCOM_API_NAME=""
CARDCOM_API_PASSWORD=""
CARDCOM_WEBHOOK_SECRET=""
CARDCOM_ENV="test"

# --- Defaults ---
DEFAULT_VAT_RATE="0.17"
