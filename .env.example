# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- Database (PostgreSQL) ---
# Local dev via docker-compose.yml:
DATABASE_URL="postgresql://hatzaa:hatzaa@localhost:5432/hatzaa?schema=public"

# --- Auth (NextAuth) ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (optional login method)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Set to "true" only once GOOGLE_CLIENT_ID/SECRET above are filled in —
# controls whether the "Continue with Google" button is shown client-side.
NEXT_PUBLIC_GOOGLE_ENABLED="false"

# --- Payments: Cardcom (Israeli payment provider) ---
# See src/lib/payments/README.md for provider comparison + setup.
CARDCOM_TERMINAL_NUMBER=""
CARDCOM_API_NAME=""
CARDCOM_API_PASSWORD=""
CARDCOM_WEBHOOK_SECRET=""
CARDCOM_ENV="test"

# --- Defaults ---
DEFAULT_VAT_RATE="0.17"
