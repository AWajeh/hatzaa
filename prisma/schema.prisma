// Hatzaa (הצעה) — Quote management SaaS for Israeli contractors & tradespeople.
// Multi-tenant schema: every business-scoped row carries businessId and must
// always be filtered by it at the query layer (see src/lib/tenant.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Locale {
  he
  ar
  en
}

enum UserRole {
  OWNER
  ADMIN
  MEMBER
}

enum ProfessionType {
  RENOVATION_CONTRACTOR // קבלן שיפוצים
  ELECTRICIAN // חשמלאי
  PLUMBER // אינסטלטור
  AC_TECHNICIAN // טכנאי מזגנים
  PAINTER // צבעי
  FLOORING // רצף
  CARPENTER // נגר
  ALUMINUM // אלומיניום
  BUILDING_CONTRACTOR // קבלן בניין
  EXCAVATION // עבודות עפר
  INSTALLER // מתקין
  TECHNICIAN // טכנאי
  OTHER
}

enum QuoteStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  EXPIRED
}

enum PlanTier {
  FREE
  PRO
  BUSINESS
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum CustomerStatus {
  LEAD
  ACTIVE
  INACTIVE
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String?
  name         String
  phone        String?
  locale       Locale    @default(he)
  image        String?
  emailVerifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships BusinessMember[]
  accounts    OAuthAccount[]

  @@map("users")
}

// OAuth (Google) linked accounts.
model OAuthAccount {
  id                String  @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  accessToken       String? @db.Text
  refreshToken      String? @db.Text
  expiresAt         Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

// ---------------------------------------------------------------------------
// Tenant (Business)
// ---------------------------------------------------------------------------

model Business {
  id   String @id @default(cuid())
  slug String @unique

  name         String
  ownerName    String?
  profession   ProfessionType @default(OTHER)
  professionOther String?

  email   String?
  phone   String?
  address String?
  city    String?

  taxId String? // עוסק מורשה / ח.פ

  logoUrl String?

  locale     Locale @default(he)
  vatRate    Decimal @default(0.17) @db.Decimal(5, 4)
  currency   String  @default("ILS")

  quoteNumberSeq   Int    @default(1000)
  quotePrefix      String @default("Q")
  defaultValidityDays Int @default(14)
  defaultTerms     String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members      BusinessMember[]
  customers    Customer[]
  services     Service[]
  serviceCategories ServiceCategory[]
  quotes       Quote[]
  subscription Subscription?
  payments     Payment[]

  @@index([slug])
  @@map("businesses")
}

enum MemberStatus {
  PENDING
  ACTIVE
}

model BusinessMember {
  id           String       @id @default(cuid())
  businessId   String
  userId       String?
  role         UserRole     @default(MEMBER)
  status       MemberStatus @default(ACTIVE)
  invitedEmail String?
  inviteToken  String?      @unique
  createdAt    DateTime     @default(now())
  acceptedAt   DateTime?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([userId])
  @@index([businessId])
  @@map("business_members")
}

// ---------------------------------------------------------------------------
// Customers
// ---------------------------------------------------------------------------

model Customer {
  id         String @id @default(cuid())
  businessId String

  name    String
  phone   String?
  email   String?
  address String?
  notes   String? @db.Text

  status CustomerStatus @default(LEAD)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  quotes   Quote[]

  @@index([businessId])
  @@index([businessId, name])
  @@map("customers")
}

// ---------------------------------------------------------------------------
// Price list (מחירון)
// ---------------------------------------------------------------------------

model ServiceCategory {
  id         String @id @default(cuid())
  businessId String
  name       String
  sortOrder  Int    @default(0)

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  services Service[]

  @@index([businessId])
  @@map("service_categories")
}

model Service {
  id         String  @id @default(cuid())
  businessId String
  categoryId String?

  name        String
  description String? @db.Text
  unit        String  @default("יחידה") // e.g. מ"ר, מטר, שעה, יחידה
  price       Decimal @db.Decimal(10, 2)
  notes       String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business   Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category   ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  quoteItems QuoteItem[]

  @@index([businessId])
  @@index([businessId, name])
  @@map("services")
}

// ---------------------------------------------------------------------------
// Quotes (הצעות מחיר)
// ---------------------------------------------------------------------------

model Quote {
  id         String @id @default(cuid())
  businessId String
  customerId String

  publicId String @unique @default(cuid()) // used in /quote/[publicId]

  number String // formatted e.g. Q-1042
  status QuoteStatus @default(DRAFT)

  title String?
  notes String? @db.Text
  terms String? @db.Text

  subtotal      Decimal @db.Decimal(12, 2)
  discountType  String  @default("amount") // "amount" | "percent"
  discountValue Decimal @default(0) @db.Decimal(12, 2)
  discountTotal Decimal @default(0) @db.Decimal(12, 2)
  vatRate       Decimal @db.Decimal(5, 4)
  vatTotal      Decimal @db.Decimal(12, 2)
  total         Decimal @db.Decimal(12, 2)

  issueDate  DateTime @default(now())
  validUntil DateTime?

  sentAt     DateTime?
  firstViewedAt DateTime?
  lastViewedAt  DateTime?
  respondedAt   DateTime?
  clientNote    String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items    QuoteItem[]
  views    QuoteView[]

  @@index([businessId])
  @@index([businessId, status])
  @@index([customerId])
  @@map("quotes")
}

model QuoteItem {
  id      String @id @default(cuid())
  quoteId String
  serviceId String?

  sortOrder   Int     @default(0)
  name        String
  description String? @db.Text
  unit        String  @default("יחידה")
  quantity    Decimal @db.Decimal(10, 2)
  unitPrice   Decimal @db.Decimal(10, 2)
  lineTotal   Decimal @db.Decimal(12, 2)

  quote   Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([quoteId])
  @@map("quote_items")
}

model QuoteView {
  id        String   @id @default(cuid())
  quoteId   String
  viewedAt  DateTime @default(now())
  ipHash    String?
  userAgent String?

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@map("quote_views")
}

// ---------------------------------------------------------------------------
// Billing: Plans, Subscriptions, Payments
// ---------------------------------------------------------------------------

model Plan {
  id       String          @id @default(cuid())
  tier     PlanTier        @unique
  name     String
  monthlyPriceIls Decimal  @db.Decimal(10, 2)
  yearlyPriceIls  Decimal  @db.Decimal(10, 2)
  quoteMonthlyLimit Int?  // null = unlimited
  features Json

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id         String @id @default(cuid())
  businessId String @unique
  planId     String

  status          SubscriptionStatus @default(TRIALING)
  billingInterval BillingInterval    @default(MONTHLY)

  trialEndsAt        DateTime?
  currentPeriodStart DateTime  @default(now())
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)
  canceledAt         DateTime?

  // Provider-side references — no card data is ever stored here.
  provider               String? // e.g. "cardcom"
  providerCustomerId     String?
  providerSubscriptionId String?
  providerTokenId        String? // tokenized card reference from provider, not a PAN

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  plan     Plan      @relation(fields: [planId], references: [id])
  payments Payment[]

  @@index([businessId])
  @@map("subscriptions")
}

model Payment {
  id             String   @id @default(cuid())
  businessId     String
  subscriptionId String?

  amount   Decimal       @db.Decimal(10, 2)
  currency String        @default("ILS")
  status   PaymentStatus @default(PENDING)

  provider          String // "cardcom"
  providerPaymentId String? @unique
  last4             String? // last 4 digits only, provided by the gateway
  cardBrand         String?
  failureReason     String?

  rawWebhookPayload Json?

  createdAt DateTime @default(now())

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([subscriptionId])
  @@map("payments")
}
